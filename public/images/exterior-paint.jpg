<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ecfeff"/>
      <stop offset="100%" stop-color="#cffafe"/>
    </linearGradient>
    <linearGradient id="can" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0284c7"/>
      <stop offset="50%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#0369a1"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <!-- Paint Can -->
  <ellipse cx="200" cy="90" rx="70" ry="20" fill="#bae6fd"/>
  <rect x="130" y="90" width="140" height="130" fill="url(#can)" rx="6"/>
  <ellipse cx="200" cy="220" rx="70" ry="18" fill="#075985"/>
  <ellipse cx="200" cy="90" rx="60" ry="14" fill="#ffffff" opacity="0.6"/>
  <!-- Label -->
  <rect x="140" y="125" width="120" height="55" fill="#ffffff" rx="4"/>
  <text x="200" y="148" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#0369a1" text-anchor="middle">SƠN NGOẠI THẤT</text>
  <text x="200" y="168" font-family="Arial, sans-serif" font-size="11" fill="#0f172a" text-anchor="middle">Jotun Chống Thấm • 5L</text>
</svg>
